{
  "name": "@local/dsh-tenant-switcher",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Tenants as workspaces: ~/.dsh/tenants/<id>/tenant.json binds a session by its working directory, injects that tenant's persona and memory, and switches the global memory library off for tenants that do not inherit it.",
  "exports": {
    ".": "./index.js",
    "./tenants": "./tenants.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "tenants.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "templates/*.json",
    "examples/**",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/tenants.test.js && node test/index.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
